# Скопируйте в .env и поправьте под себя. Файл .env в git не попадает.

# HTTP-прокси VPN-клиента на хосте. host.docker.internal — это сам компьютер,
# если смотреть из контейнера. Пусто — браузер и OpenRouter ходят напрямую
# (ChatGPT из России без VPN не откроется).
VPN_PROXY=http://host.docker.internal:10809

# Ключ OpenRouter. В контейнере нет шифрования Windows (DPAPI), и ключ,
# введённый в интерфейсе под Windows, здесь не расшифруется — задайте его тут
# или введите заново в настройках.
OPENROUTER_API_KEY=

# Прокси только для сборки образа — если pip или загрузка браузера не
# проходят напрямую. Обычно пусто.
BUILD_PROXY=
