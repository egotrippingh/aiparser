# Виртуальное окружение и кэш Python
.venv/
__pycache__/
*.pyc

# Данные пользователя. По решению владельца (10.09.2026) в приватный
# репозиторий идут только: база результатов, скриншоты и файлы cookies
# браузерных профилей — чтобы на другом ПК можно было сразу работать без
# повторного входа в аккаунты. Всё остальное из data/ остаётся локальным:
# кэш браузера (сотни мегабайт), сохранённые пароли, отладочные дампы,
# временные файлы.
#
# ВНИМАНИЕ: cookies — это живые сессии ChatGPT, Perplexity, Яндекса и Google.
# Кто получит доступ к репозиторию, войдёт в эти аккаунты без пароля. Если
# доступ утёк — выйти со всех устройств в каждом сервисе, это обнулит cookies.
data/*
!data/aiparser.db
!data/screenshots/
!data/profiles/
data/profiles/*/*
!data/profiles/*/cookies.sqlite
!data/profiles/*/cookies.sqlite-wal

# Браузер Camoufox (~250 МБ), ставится командой `python -m camoufox fetch`
runtime/

# Служебное
.playwright-mcp/
*.log
.idea/
.vscode/
